{
  "name": "halo-proxy-vscode",
  "displayName": "Halo Proxy Dashboard",
  "description": "Companion extension for the Halo Proxy local reverse proxy",
  "version": "0.1.0",
  "publisher": "n3m1k",
  "repository": {
    "type": "git",
    "url": "https://github.com/n3m1k/halo-proxy"
  },
  "license": "GPL-3.0-or-later",
  "icon": "resources/icon.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "halo-sidebar",
          "title": "Halo Proxy",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "halo-sidebar": [
        {
          "id": "halo-services",
          "name": "Local Services",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "halo.refresh",
        "title": "Refresh Halo Proxy Services",
        "icon": "$(refresh)"
      },
      {
        "command": "halo.open",
        "title": "Open Local Domain in Browser",
        "icon": "$(browser)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "halo.refresh",
          "when": "view == halo-services",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "halo.open",
          "when": "view == halo-services",
          "group": "inline"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "bun run build",
    "build": "bun build ./src/extension.ts --outfile=./out/extension.js --target=node --external=vscode",
    "watch": "bun build ./src/extension.ts --outfile=./out/extension.js --target=node --external=vscode --watch"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "@types/node": "20.x",
    "typescript": "^5.4.5"
  }
}
